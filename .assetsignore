# Cloudflare 静态资源上传排除表（.gitignore 语法，路径相对项目根）
# 部署 = 上传整个项目目录时，下面这些不会进 CDN。
# 站点运行需要的文件（*.html / css / js / i18n/index.js / i18n/lang/*.js / 各资源目录 /
# desktop-manifest.json / favicon.ico / robots.txt / sitemap.xml / sw.js / _headers / _redirects）
# 一律不要写进来。

.git
.git/*
.gitignore
.gitattributes
.wrangler
README.md
readme/

# 工程件与构建产物：网站不需要（源码全在 build/ 下）
build
build/*
node_modules
node_modules/*
.pnpm-store
.pnpm-store/*

# 翻译工作流源文件（只在本地用，线上读 i18n/index.js + i18n/lang/*.js）
i18n/ui-strings.csv
i18n/shop-strings.csv
i18n/resources-strings.csv
i18n/hotspot-strings.csv
i18n/title-strings.csv

package.json
pnpm-lock.yaml
pnpm-workspace.yaml