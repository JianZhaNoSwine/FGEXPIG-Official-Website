{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FGEXPIG",
  "version": "1.0.7-r",
  "identifier": "cc.fgexpig.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
