{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FGEXPIG 壳：本地页面 + 本地服务源（127.0.0.1）都允许使用核心 API 与自定义命令",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*", "https://fgexpig.cc", "https://*.fgexpig.cc"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:webview:default",
    "core:app:default",
    "allow-resolution-get",
    "allow-resolution-set",
    "allow-aspect-set",
    "allow-state-load",
    "allow-state-save",
    "allow-state-report",
    "allow-mapstats-store-get",
    "allow-mapstats-store-set",
    "allow-mapstats-fetch",
    "allow-quit-app",
    "allow-back-to-menu",
    "allow-launcher-splash-done",
    "allow-launcher-enter",
    "allow-launcher-quit",
    "allow-launcher-open-site",
    "allow-launcher-github",
    "allow-launcher-listener-ready",
    "allow-launcher-listener-failed",
    "allow-bridge-loaded",
    "allow-bridge-failed"
  ]
}
