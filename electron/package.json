{
  "name": "fgexpig-desktop",
  "version": "0.3.5",
  "private": true,
  "description": "探索的猪仔官方网站 Electron 桌面端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "manifest": "node ../tools/build-desktop-manifest.js",
    "dist": "pnpm run manifest && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fgexpig.desktop",
    "productName": "FGEXPIG",
    "asar": true,
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "../desktop-dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FGEXPIG",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "author": "FGEXPIG",
  "productName": "FGEXPIG"
}
